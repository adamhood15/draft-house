# Supabase — free tier project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Sleeper API (public, no secrets)
SLEEPER_API_BASE_URL=https://api.sleeper.app/v1
SLEEPER_API_TIMEOUT=10000
SLEEPER_LEAGUE_ID=

# FantasyPros Premium (optional paid upgrade path — see docs/SLEEPER.md).
# Leave unset to use the free Fantasy Football Calculator ADP source by default.
# FANTASYPROS_API_KEY=

# Seed script only (see scripts/seed-from-sleeper.js) — a real Draft House user id
# to set as the seeded league's commissioner.
SEED_COMMISSIONER_USER_ID=
